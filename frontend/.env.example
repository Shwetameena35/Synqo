# ==============================================================================
# Synqo Frontend Environment Configuration Template
# Duplicate this file as '.env' in the frontend/ directory for local development.
# ==============================================================================

# Backend Server URL
# Default: http://localhost:8080 (Set your backend server base URL)
VITE_API_URL=http://localhost:8080

# API Version Base Path (Default: /api/v1)
VITE_API_BASE_PATH=/api/v1

# Real-time Collaboration & Telemetry WebSocket URL
# Default: ws://localhost:8080/api/v1/ws
VITE_WS_URL=ws://localhost:8080/api/v1/ws

# Application Display Name
VITE_APP_NAME=Synqo
