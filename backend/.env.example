# Synqo Server Configuration
PORT=8080

# JWT Authentication
# Secret key used for signing JWT tokens
JWT_SECRET=api-playground-hub-secret-key-2026

# Token expiration duration (defaults to 24h if omitted)
# You can use JWT_EXPIRATION_HOURS (e.g. 24) or JWT_EXPIRES_IN (e.g. 24h, 7d, 168h, 30m)
JWT_EXPIRATION_HOURS=24
JWT_EXPIRES_IN=24h

# Database Configuration (Optional PostgreSQL connection string, defaults to local SQLite)
# DATABASE_URL=postgres://user:password@localhost:5432/synqo
SQLITE_PATH=api_playground.db
